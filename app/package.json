{
  "name": "sticks-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc && vite build",
    "typecheck": "tsc",
    "tauri": "tauri",
    "app:install": "node scripts/install-app.mjs",
    "probe:jev": "cargo build -q -p sticks-cli && node scripts/jev-probe.ts",
    "probe:local": "cargo run -q --release -p sticks-local --features llama --bin sticks-local-probe --",
    "model:get": "node scripts/get-model.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@typesafe-ai/sdk": "^0.7.0",
    "three": "^0.186.1"
  }
}
